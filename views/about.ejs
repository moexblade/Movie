<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="/style/header.css">
        <link rel="stylesheet" href="/style/index.css">
        <link rel="stylesheet" href="/style/footer.css">
        <link rel="stylesheet" href="/style/home.css">
        <link rel="stylesheet" href="/style/about.css">
        <title>About Us</title>
    </head>
    <body>
        <%- include("partials/header") %>

        <div class="container">
            <h1>ABOUT US</h1>
            <h2>Discover movies worth watching.</h2>
            <div class="container" style="gap: 0px;">
                <h3>Find movies, explore their details,</h3>
                <h3>and discover your next favorite film.</h3>
            </div>
            <form action="/">
                <button class="explore-btn">Explore Movies</button>
            </form>
        </div>

        <hr>

        <div class="container">
            <h2>What is Movie.</h2>
            <p>is a simple place for movie lovers
                to discover films and learn more about them.
            </p>
            <p>Search for movies, explore ratings, release dates,
                genres, actors, and more — all in one place.</p>
        </div>

        <hr>

        <div class="container">
            <h2>What Users Can Do?</h2>

            <div class="container-row">
                <div class="card">
                    <span class="card__title">Search Movies</span>

                    <p class="card__content">
                        Find movies by title and explore
                        their details.
                    </p>
                </div>

                <div class="card">
                    <span class="card__title">Discover Stories</span>

                    <p class="card__content">
                        Find popular and interesting films
                        to watch.
                    </p>
                </div>

                <div class="card">
                    <span class="card__title">Movie & Details</span>

                    <p class="card__content">
                        Explore ratings,
                        genres, actors,
                        and more.
                    </p>
                </div>
            </div>
        </div>
        <%- include("partials/footer") %>
    </body>
</html>
<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="/style/index.css">
        <link rel="stylesheet" href="/style/header.css">
        <link rel="stylesheet" href="/style/footer.css">
        <link rel="stylesheet" href="/style/details.css">
        <link rel="stylesheet" href="/style/list.css">
        <%- include("partials/seo", {
            title: searchWord ? `Search results for ${searchWord} | Movie.` : "Search Movies | Movie.",
            description: searchWord ? `Browse movie search results for ${searchWord}.` : "Search movies by title and explore ratings, genres, cast, and details.",
            canonicalPath: "/search",
            robots: "noindex,follow"
        }) %>
    </head>
    <body>
        <%- include("partials/header") %>

        <div id="content" class="movie-info">
            <%- include("partials/search", { movies: locals.movies }) %>
        </div>

        <%- include("partials/pages", { movies: locals.movies }) %>

        <%- include("partials/footer") %>
        <script src="/script/movie.js" defer></script>
    </body>
</html>

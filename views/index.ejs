<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="/style/index.css">
        <link rel="stylesheet" href="/style/header.css">
        <link rel="stylesheet" href="/style/footer.css">
        <link rel="stylesheet" href="/style/details.css">
        <link rel="stylesheet" href="/style/list.css">
        <title>Movie</title>
    </head>
    <body>
        <%- include("partials/header") %>
        
        <div id="content" class="movie-info">
            <% if (movies) { %>
            <div class="container">

                <% for (let i = 0; i < movies.Search.length; i++) { %>
                <div class="movie-list">

                    <div class="movie-poster-list">
                        <img
                            src="<%= movies.Search[i].Poster %>"
                            alt="<%= movies.Search[i].Title %> poster">
                    </div>

                    <div class="movie-poster-list-details">

                        <div class="movie-title">
                            Title: <%= movies.Search[i].Title %>
                        </div>

                        <div class="movie-year">
                            Year: <%= movies.Search[i].Year %>
                        </div>

                        <div class="movie-type">
                            Type: <%= movies.Search[i].Type %>
                        </div>

                    </div>

                </div>
                <% } %>
            </div>
            <% } %>
        </div>

        <%- include("partials/footer") %>
        <script src="/script/movie.js" defer></script>
    </body>
</html>
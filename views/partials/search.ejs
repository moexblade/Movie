            <% if (movies && movies.Search) { %>
            <div class="container">

                <% for (let i = 0; i < movies.Search.length; i++) { %>
                <div class="movie-list">

                    <div class="search-poster-card">
                        <a href="/movies/<%= movies.Search[i].imdbID %>">
                            <img
                                src="<%= movies.Search[i].Poster %>"
                                alt="<%= movies.Search[i].Title %> poster">
                        </a>
                    </div>

                    <div class="movie-poster-list-details">

                        <div class="movie-title">
                            <%= movies.Search[i].Title %>
                        </div>

                        <div class="movie-year">
                            Year: <%= movies.Search[i].Year %>
                        </div>

                        <div class="movie-type">
                            Type: <%= movies.Search[i].Type %>
                        </div>
                        
                        <div class="movie-runtime">
                            Runtime: <%= movies.Search[i].Runtime %>
                        </div>
                        
                        <div class="movie-imdbRating">
                            Rating: <%= movies.Search[i].imdbRating %>
                        </div>

                    </div>

                </div>
                <% } %>
            </div>
            <% } else { %>
            <div class="search-empty-state" role="status">
                <p class="search-empty-code">NO RESULTS</p>
                <h2>That search came up empty</h2>
                <p>Try another title, spelling, or a different keyword.</p>
                <a href="/">Back to home</a>
            </div>
            <% } %>
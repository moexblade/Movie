<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="/style/index.css">
        <link rel="stylesheet" href="/style/header.css">
        <link rel="stylesheet" href="/style/footer.css">
        <link rel="stylesheet" href="/style/details.css">
        <link rel="stylesheet" href="/style/list.css">
        <link rel="stylesheet" href="/style/home.css">
        <title>Movie</title>
    </head>

    <body>
        <%- include("partials/header") %>

        <div class="container">
            <h1>FIND YOUR NEXT MOVIE</h1>
            <h2>Search thousands of movies and discover something to watch</h2>
            <form id="search-form" class="home-search" action="/search"
                method="GET">
                <input id="search-input" type="search"
                    placeholder="Search by title"
                    name="word" required>
                <button type="submit" style="width: 8rem;">Search</button>
            </form>
        </div>

        <hr>

        <div class="row">
            <% if (movies && movies.length) { %>
            <div class="movie-grid">
                <% movies.forEach((movie) => { %>
                <div class="card">
                    <a href="/movies/<%= movie.imdbID %>">
                        <img src="<%= movie.Poster %>"
                            alt="<%= movie.Title %> poster">
                    </a>
                    <div class="movie-card-info">
                        <h3><%= movie.Title %></h3>

                        <div class="movie-meta">
                            <span class="rating">★ <%= movie.imdbRating
                                %></span>
                                <span class="Runtime"><%= movie.Runtime %></span>
                            <span class="year"><%= movie.Year %></span>
                        </div>
                    </div>
                </div>
                <% }); %>
            </div>
            <% } else { %>
            <p>No featured movies available right now.</p>
            <% } %>
        </div>
        <%- include("partials/footer") %>
    </body>
</html>